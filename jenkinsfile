pipeline{
    agent {
        node {
            label 'Workstation'
            }
           }
    stages {
        stage ('Docker Build') {
            steps {
            sh 'docker build -t thanukus3/r-cart .'
            }
        }
       stage ('Docker Push') {
             steps {
                sh 'docker push thanukus3/r-cart'
             }
        }
   }
  }